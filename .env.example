APP_NAME=Argumenta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database configuration (Defaults pre-configured for Docker Compose environment)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=argumenta
DB_USERNAME=argumenta
DB_PASSWORD=argumenta-local

# Session & Cache configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue configuration (Database queue recommended for cPanel / production cron worker)
QUEUE_CONNECTION=database

# Filesystem & Storage configuration
FILESYSTEM_DISK=local
RECORDINGS_DISK=private

# External S3-compatible Object Storage (SumoPod S3 / Cloudflare R2 / AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=argumenta-recordings
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI Orchestration & Evaluation
AI_PROVIDER=simulated # simulated | gemini | sumopod
AI_MODEL_JUDGE=gemini-1.5-pro
AI_MODEL_COACH=gemini-1.5-flash
GEMINI_API_KEY=
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://api.sumopod.com/v1

# Speech-to-Text (STT) Provider
STT_PROVIDER=simulated # simulated | whisper | gemini
